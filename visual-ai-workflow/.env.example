# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key

# --- Inngest ---
# Set to 1 when using the local Inngest dev server (npx inngest-cli@latest dev)
INNGEST_DEV=1

# Signing key from your Inngest production project (https://app.inngest.com)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Local Inngest dev server URL (default for inngest-cli dev)
# INNGEST_DEV_URL=http://localhost:8288